# reading-service — copy to .env and fill in real values
PORT=3002
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/ielts_reading_db?appName=Cluster0

# JWT Authentication
JWT_SECRET=your_strong_jwt_secret_here
JWT_EXPIRES_IN=7d

# Google Gemini API key (fallback; primary key fetched from auth-service DB)
GEMINI_API_KEY=your_gemini_api_key_here

# Internal service communication
AUTH_SERVICE_INTERNAL_URL=http://auth-service:3001
INTERNAL_SECRET=your_strong_internal_secret_here
