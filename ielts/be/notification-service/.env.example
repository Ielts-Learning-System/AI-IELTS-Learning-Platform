# notification-service
PORT=3006
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ielts_notifications?retryWrites=true&w=majority

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# JWT (same secret shared across services for token verification)
JWT_SECRET=your_jwt_secret_here

# Email — NodeMailer SMTP (dev) or SendGrid (prod)
EMAIL_PROVIDER=nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SENDGRID_API_KEY=SG.xxxxx
EMAIL_FROM=noreply@ielts-platform.com

# Web Push (VAPID keys — generate via `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@ielts-platform.com

# CRON
CRON_REMINDER_SCHEDULE=0 8 * * *
