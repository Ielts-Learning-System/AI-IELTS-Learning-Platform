# ==========================================
# SHARED ROOT CONFIG — copy to .env and fill in real values
# ==========================================

# 1. Database — per-service URIs (used by docker-compose variable substitution)
MONGO_URI_AUTH=mongodb+srv://<user>:<password>@<cluster>/ielts_auth_db?appName=Cluster0
MONGO_URI_BILLING=mongodb+srv://<user>:<password>@<cluster>/ielts_billing_db?appName=Cluster0
MONGO_URI_PAYMENT=mongodb+srv://<user>:<password>@<cluster>/ielts_payment_db?appName=Cluster0
MONGO_URI_READING=mongodb+srv://<user>:<password>@<cluster>/ielts_reading_db?appName=Cluster0
MONGO_URI_LISTENING=mongodb+srv://<user>:<password>@<cluster>/ielts_listening_db?appName=Cluster0
MONGO_URI_WRITING=mongodb+srv://<user>:<password>@<cluster>/ielts_writing_db?appName=Cluster0
MONGO_URI_SPEAKING=mongodb+srv://<user>:<password>@<cluster>/ielts_speaking_db?appName=Cluster0
MONGO_URI_NOTIFICATION=mongodb+srv://<user>:<password>@<cluster>/ielts_notification_db?appName=Cluster0
MONGO_URI_LESSON=mongodb+srv://<user>:<password>@<cluster>/ielts_lesson_db?appName=Cluster0
MONGO_URI_MEDIA=mongodb+srv://<user>:<password>@<cluster>/ielts_media_db?appName=Cluster0

# Optional: legacy shared DB (kept for migration script reference)
MONGO_URI_OLD_SHARED=mongodb+srv://<user>:<password>@<cluster>/?appName=Cluster0

# Optional: backup DB (managed by sync-daemon)
MONGO_URI_BACKUP=mongodb+srv://<user>:<password>@<cluster>/ielts_backup_db?appName=Cluster0

# 2. Message broker & cache
RABBITMQ_URL=amqp://rabbitmq:5672
REDIS_URL=redis://redis:6379

# 3. Security
JWT_SECRET=your_strong_jwt_secret_here

# 4. Service ports
PORT_GATEWAY=3000
PORT_AUTH=3001
PORT_READING=3002
PORT_LISTENING=3003
PORT_WRITING=3004
PORT_BILLING=3005
PORT_SPEAKING=3006
PORT_NOTIFICATION=3007
PORT_MEDIA=3010

# 5. Cloudinary (file uploads / CDN)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 6. VietQR payment config
VIETQR_BANK_ID=YOUR_BANK_CODE
VIETQR_ACCOUNT_NO=YOUR_ACCOUNT_NUMBER
VIETQR_ACCOUNT_NAME=YOUR_ACCOUNT_NAME
