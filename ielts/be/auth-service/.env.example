PORT=3001
MONGO_URI=mongodb://localhost:27017/ielts_auth
JWT_SECRET=your_jwt_secret_here

# Local Node.js run on host machine
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Docker Compose run inside container network
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Team-based monthly quota baseline for Gemini key management
# Active team used when keyTeam is missing/invalid
GEMINI_ACTIVE_KEY_TEAM=starter
# Fallback if team map is missing or malformed
DEFAULT_MONTHLY_TOKEN_QUOTA=1000000
# JSON object: team -> monthly token quota
GEMINI_TEAM_MONTHLY_QUOTAS={"starter":1000000,"pro":5000000,"enterprise":20000000}
